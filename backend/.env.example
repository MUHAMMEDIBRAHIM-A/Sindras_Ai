# Copy this file to .env and fill in your values

# PostgreSQL connection (with pgvector extension installed)
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/synras_rag

# Gemini API Key (server-side only — never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret (generate a strong random string)
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# File upload limits
MAX_UPLOAD_SIZE_MB=20

# Chunk settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
